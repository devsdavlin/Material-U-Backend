# FORMATO de variables. Solo nombres con ejemplos falsos.
# Las CLAVES REALES van en tu .env local (no se sube a GitHub)
# y en los secretos de Coolify al desplegar. Nunca aquí.

# Conexión a la base Neon (la real la pegas en Coolify)
DATABASE_URL=postgresql://<usuario>:<clave>@<host-neon>:5432/<base>?sslmode=require

# Clave para firmar los inicios de sesión (inventa una larga, mínimo 32 letras)
JWT_SECRET=<una-clave-secreta-larga-de-mas-de-32-caracteres>

# Puerto donde escucha el backend (Coolify lo detecta solo)
PORT=3000

# En el servidor siempre va production
NODE_ENV=production

# Dirección exacta de tu frontend (sin esto el navegador bloquea las peticiones).
# Ejemplo: https://mi-inventario.midominio.com  (en local: http://localhost:5173)
CORS_ORIGIN=*
