generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Warehouse {
  id_warehouse   Int         @id @default(autoincrement())
  warehouse_name String      @db.VarChar
  activo         Boolean?    @default(true)
  entries        entries[]
  exits          exits[]
  inventory      inventory[]
  users          User[]

  @@map("warehouse")
}

model User {
  id_user       Int        @id @default(autoincrement())
  warehouse_id  Int?
  email         String     @unique @db.VarChar
  password_hash String     @db.VarChar
  rol           String     @db.VarChar
  activo        Boolean?   @default(true)
  name          String     @default("") @db.VarChar
  entries       entries[]
  exits         exits[]
  warehouse     Warehouse? @relation(fields: [warehouse_id], references: [id_warehouse])

  @@map("users")
}

model entries {
  id_entry     Int       @id @default(autoincrement())
  entry_number String    @db.VarChar(50)
  warehouse_id Int
  material_id  Int
  user_id      Int
  provider     String?   @db.VarChar(150)
  quantity     Decimal   @db.Decimal(10, 2)
  unit_value   Decimal   @db.Decimal(12, 2)
  total_value  Decimal   @db.Decimal(12, 2)
  entry_date   DateTime? @default(now()) @db.Timestamp(6)
  materials    materials @relation(fields: [material_id], references: [id_material], onDelete: NoAction, onUpdate: NoAction, map: "fk_entries_material")
  users        User      @relation(fields: [user_id], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_entries_user")
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id_warehouse], onDelete: NoAction, onUpdate: NoAction, map: "fk_entries_warehouse")

  @@unique([warehouse_id, entry_number], map: "unique_warehouse_entry_number")
  @@index([warehouse_id, material_id])
}

model exits {
  id_exit      Int       @id @default(autoincrement())
  exit_number  String    @db.VarChar(50)
  warehouse_id Int
  material_id  Int
  user_id      Int
  cost_center  String?   @db.VarChar(150)
  quantity     Decimal   @db.Decimal(10, 2)
  unit_value   Decimal   @db.Decimal(12, 2)
  total_value  Decimal   @db.Decimal(12, 2)
  exit_date    DateTime? @default(now()) @db.Timestamp(6)
  materials    materials @relation(fields: [material_id], references: [id_material], onDelete: NoAction, onUpdate: NoAction, map: "fk_exits_material")
  users        User      @relation(fields: [user_id], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_exits_user")
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id_warehouse], onDelete: NoAction, onUpdate: NoAction, map: "fk_exits_warehouse")

  @@unique([warehouse_id, exit_number], map: "unique_warehouse_exit_number")
  @@index([warehouse_id, material_id])
}

model inventory {
  id_inventory  Int       @id @default(autoincrement())
  warehouse_id  Int
  material_id   Int
  current_stock Decimal   @default(0) @db.Decimal(10, 2)
  min_stock     Decimal   @default(0) @db.Decimal(14, 2)
  materials     materials @relation(fields: [material_id], references: [id_material], onDelete: NoAction, onUpdate: NoAction, map: "fk_material")
  warehouse     Warehouse @relation(fields: [warehouse_id], references: [id_warehouse], onDelete: NoAction, onUpdate: NoAction, map: "fk_warehouse")

  @@unique([warehouse_id, material_id], map: "unique_warehouse_material")
}

model materials {
  id_material   Int         @id @default(autoincrement())
  material_name String      @db.VarChar(150)
  category      String      @db.VarChar(100)
  unit          String      @db.VarChar(50)
  activo        Boolean?    @default(true)
  internal_code String?     @unique @db.VarChar(50)
  entries       entries[]
  exits         exits[]
  inventory     inventory[]
}
